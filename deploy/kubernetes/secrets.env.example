# Copy to secrets.env, fill every value, then create the Kubernetes Secret.
# Generate the three cryptographic secrets separately with: openssl rand -hex 32
NEXTAUTH_SECRET=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
# Use the SAME MONGO_APP_PASSWORD above inside this URI, without braces.
MONGODB_URI=mongodb://veralabel:REPLACE_WITH_MONGO_APP_PASSWORD@db:27017/veralabel?authSource=veralabel
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Optional email credentials:
SMTP_USER=
SMTP_PASS=
