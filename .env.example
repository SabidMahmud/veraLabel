# Copy to .env. Never commit the real file.
# Docker Compose reads this file automatically. Kubernetes uses secrets.env instead.

# The exact URL opened in the browser; no trailing slash.
NEXTAUTH_URL=http://localhost:8080
# Generate each secret separately: openssl rand -hex 32
NEXTAUTH_SECRET=
MONGO_ROOT_PASSWORD=
# Hex avoids special characters that would need URL-encoding in the MongoDB URI.
MONGO_APP_PASSWORD=

# The initial administrator. Password must contain at least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

HTTP_PORT=8080
# Keep localhost for a local deployment or an external reverse proxy.
# Set 0.0.0.0 only when deliberately exposing the service to your network.
BIND_ADDRESS=127.0.0.1
# Host directory; create it before starting Docker. Relative paths use this repo.
DATA_FOLDER_PATH=./data/images
VERALABEL_IMAGE=veralabel:local

# Optional public HTTPS, used by docker-compose.https.yml.
# Set NEXTAUTH_URL=https://annotate.example.com as well.
DOMAIN=annotate.example.com

# Optional SMTP for password reset. Leave blank to disable email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VeraLabel <noreply@example.com>
