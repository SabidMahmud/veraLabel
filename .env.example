# ==============================================================================
# VERALABEL - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file and rename it to '.env'
# 2. Update the values to match your lab's server environment.
# 3. Run `docker compose up -d` to launch the platform.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. APPLICATION SECURITY (REQUIRED)
# ------------------------------------------------------------------------------
# NEXTAUTH_SECRET is used to encrypt user session cookies.
# IMPORTANT: Generate a secure random string in your terminal using: 
#   openssl rand -base64 32
NEXTAUTH_SECRET=replace-this-with-a-very-secure-random-string

# NEXTAUTH_URL must exactly match the base URL where annotators will access the app.
# - If running locally on your laptop: http://localhost:80
# - If deployed on an internal lab server IP: http://192.168.1.100
# - If deployed on a public domain: https://annotate.mylab.edu
NEXTAUTH_URL=http://localhost:80


# ------------------------------------------------------------------------------
# 2. IMAGE STORAGE CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# STORAGE_PROVIDER determines how medical images are served to the annotators.
# Currently supported: 'local' (Server hard drive, NAS, or mounted network drive)
STORAGE_PROVIDER=local

# DATA_FOLDER_PATH is the ABSOLUTE path on your HOST machine where images live.
# Docker will safely mount this folder as read-only into the Nginx proxy container.
# - Example (Windows): D:\MedicalDatasets\Images
# - Example (Linux/NAS): /mnt/nas/datasets/medical_images
DATA_FOLDER_PATH=./data/images


# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# If you are using the included `docker-compose.yml`, leave this exactly as is.
# The 'db' hostname automatically resolves to the isolated MongoDB Docker container.
# 
# Note: If you prefer to use a cloud database like MongoDB Atlas, replace this 
# with your secure connection string (e.g., mongodb+srv://user:pass@cluster.mongodb.net/veralabel)
MONGODB_URI=mongodb://db:27017/veralabel


# ------------------------------------------------------------------------------
# 4. INITIAL SYSTEM ADMINISTRATOR
# ------------------------------------------------------------------------------
# When VeraLabel boots for the very first time, it will automatically provision 
# a System Administrator account using these credentials so you can log in.
# IMPORTANT: You should change this password in the UI immediately after logging in.
ADMIN_EMAIL=admin@veralabel.local
ADMIN_PASSWORD=secure-setup-password-123!


# ------------------------------------------------------------------------------
# 5. DEVELOPMENT / DEBUGGING
# ------------------------------------------------------------------------------
# Set to 'true' ONLY in development environments to bypass the login screen.
# WARNING: NEVER set this to 'true' in a production or clinical environment!
AUTH_BYPASS=false


# ------------------------------------------------------------------------------
# 6. S3 CLOUD STORAGE (FUTURE ITERATION CAPABILITY)
# ------------------------------------------------------------------------------
# These variables are reserved for future architectural updates when migrating
# to AWS S3, Cloudflare R2, or MinIO object storage.
# S3_ENDPOINT=
# S3_BUCKET_NAME=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
